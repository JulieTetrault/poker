{
  "openapi": "3.1.1",
  "info": {
    "title": "Poker API",
    "version": "0.1.0-draft"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Games"
    },
    {
      "name": "Decks"
    },
    {
      "name": "Players"
    },
    {
      "name": "Cards"
    }
  ],
  "paths": {
    "/api/v1/games": {
      "post": {
        "operationId": "createGame",
        "tags": [
          "Games"
        ],
        "summary": "Create an empty game",
        "responses": {
          "201": {
            "description": "Create an empty game.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGameResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "id": "11111111-1111-4111-8111-111111111111",
                      "name": "Example game"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameRequest"
              },
              "example": {
                "name": "Example game"
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{gameId}": {
      "delete": {
        "operationId": "deleteGame",
        "tags": [
          "Games"
        ],
        "summary": "Delete a game",
        "responses": {
          "204": {
            "description": "No response body."
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/decks": {
      "post": {
        "operationId": "createDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Create a standard deck",
        "responses": {
          "201": {
            "description": "Create a standard deck.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDeckResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "id": "22222222-2222-4222-8222-222222222222"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{gameId}/decks": {
      "post": {
        "operationId": "addDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Permanently add a deck to a game",
        "responses": {
          "204": {
            "description": "Deck added. No response body."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDeckRequest"
              },
              "example": {
                "deckId": "22222222-2222-4222-8222-222222222222"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/decks/cards": {
      "get": {
        "operationId": "countCards",
        "tags": [
          "Decks"
        ],
        "summary": "Count undealt copies of each face",
        "responses": {
          "200": {
            "description": "Count undealt copies of each face.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUndealtCardsResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "hearts": {
                        "king": 1,
                        "queen": 1,
                        "jack": 1,
                        "10": 1,
                        "9": 1,
                        "8": 1,
                        "7": 1,
                        "6": 1,
                        "5": 1,
                        "4": 1,
                        "3": 1,
                        "2": 1,
                        "ace": 1
                      },
                      "spades": {
                        "king": 1,
                        "queen": 1,
                        "jack": 1,
                        "10": 1,
                        "9": 1,
                        "8": 1,
                        "7": 1,
                        "6": 1,
                        "5": 1,
                        "4": 1,
                        "3": 1,
                        "2": 1,
                        "ace": 1
                      },
                      "clubs": {
                        "king": 1,
                        "queen": 1,
                        "jack": 1,
                        "10": 1,
                        "9": 1,
                        "8": 1,
                        "7": 1,
                        "6": 1,
                        "5": 1,
                        "4": 1,
                        "3": 1,
                        "2": 1,
                        "ace": 1
                      },
                      "diamonds": {
                        "king": 1,
                        "queen": 1,
                        "jack": 1,
                        "10": 1,
                        "9": 1,
                        "8": 1,
                        "7": 1,
                        "6": 1,
                        "5": 1,
                        "4": 1,
                        "3": 1,
                        "2": 1,
                        "ace": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/decks/suits/cards": {
      "get": {
        "operationId": "countSuits",
        "tags": [
          "Decks"
        ],
        "summary": "Count undealt cards by suit",
        "responses": {
          "200": {
            "description": "Count undealt cards by suit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUndealtSuitCardsCountResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "hearts": 13,
                      "spades": 13,
                      "clubs": 13,
                      "diamonds": 13
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/decks/shuffle": {
      "post": {
        "operationId": "shuffleShoe",
        "tags": [
          "Decks"
        ],
        "summary": "Shuffle remaining cards",
        "responses": {
          "204": {
            "description": "No response body."
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/players": {
      "post": {
        "operationId": "addPlayer",
        "tags": [
          "Players"
        ],
        "summary": "Add a player",
        "responses": {
          "201": {
            "description": "Add a player.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddPlayerResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "id": "33333333-3333-4333-8333-333333333333",
                      "name": "A"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPlayerRequest"
              },
              "example": {
                "name": "A"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      },
      "get": {
        "operationId": "listPlayers",
        "tags": [
          "Players"
        ],
        "summary": "List players by hand value",
        "responses": {
          "200": {
            "description": "List players by hand value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPlayersHandValueResponse"
                },
                "examples": {
                  "success": {
                    "value": [
                      {
                        "id": "33333333-3333-4333-8333-333333333333",
                        "name": "A",
                        "handValue": 1
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/players/{playerId}": {
      "delete": {
        "operationId": "removePlayer",
        "tags": [
          "Players"
        ],
        "summary": "Remove a player",
        "responses": {
          "204": {
            "description": "No response body."
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "33333333-3333-4333-8333-333333333333"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/players/{playerId}/cards": {
      "get": {
        "operationId": "getHand",
        "tags": [
          "Cards"
        ],
        "summary": "Get a player hand",
        "responses": {
          "200": {
            "description": "Get a player hand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPlayerCardsResponse"
                },
                "examples": {
                  "success": {
                    "value": [
                      {
                        "suit": "hearts",
                        "rank": "ace"
                      }
                    ]
                  },
                  "empty": {
                    "value": []
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "33333333-3333-4333-8333-333333333333"
          }
        ]
      }
    },
    "/api/v1/games/{gameId}/players/{playerId}/cards/deal": {
      "post": {
        "operationId": "dealCards",
        "tags": [
          "Cards"
        ],
        "summary": "Deal cards to a player",
        "responses": {
          "200": {
            "description": "Deal cards to a player.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealCardsResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Request 1 card from 52 remaining",
                    "value": {
                      "dealtCards": 1,
                      "remainingCards": 51
                    }
                  },
                  "empty": {
                    "summary": "Request 1 card from an empty shoe",
                    "value": {
                      "dealtCards": 0,
                      "remainingCards": 0
                    }
                  },
                  "partial": {
                    "summary": "Request 13 cards with only 10 remaining",
                    "value": {
                      "dealtCards": 10,
                      "remainingCards": 0
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealCardsRequest"
              },
              "example": {
                "count": 1
              }
            }
          }
        },
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "33333333-3333-4333-8333-333333333333"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suit",
          "rank"
        ],
        "properties": {
          "suit": {
            "type": "string",
            "$ref": "#/components/schemas/Suit"
          },
          "rank": {
            "$ref": "#/components/schemas/Rank"
          }
        }
      },
      "Deck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gameId",
          "cards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "gameId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Null until the deck is attached to a game's shoe."
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "minItems": 52,
            "maxItems": 52
          }
        }
      },
      "Game": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "shoe",
          "players"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "shoe": {
            "$ref": "#/components/schemas/Shoe"
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          }
        }
      },
      "Player": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gameId",
          "name",
          "cards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        }
      },
      "Rank": {
        "type": "string",
        "enum": [
          "ace",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8",
          "9",
          "10",
          "jack",
          "queen",
          "king"
        ]
      },
      "Shoe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decks"
        ],
        "properties": {
          "decks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Deck"
            }
          }
        }
      },
      "Suit": {
        "type": "string",
        "enum": [
          "hearts",
          "spades",
          "clubs",
          "diamonds"
        ]
      },
      "AddDeckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deckId"
        ],
        "properties": {
          "deckId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AddPlayerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S",
            "description": "At most 100 input characters; must contain a non-whitespace character. Trim for storage; duplicate names allowed."
          }
        }
      },
      "CreateGameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S",
            "description": "Game name must contain at least one non-whitespace character."
          }
        }
      },
      "AddPlayerResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDeckResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateGameResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DealCardsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "DealCardsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dealtCards",
          "remainingCards"
        ],
        "properties": {
          "dealtCards": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "remainingCards": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail",
          "status",
          "code"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          }
        }
      },
      "GetPlayerCardResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suit",
          "rank"
        ],
        "properties": {
          "suit": {
            "type": "string"
          },
          "rank": {
            "type": "string"
          }
        }
      },
      "GetPlayerCardsResponse": {
        "type": "array",
        "additionalProperties": false,
        "items": {
          "$ref": "#/components/schemas/GetPlayerCardResponse"
        }
      },
      "GetPlayerHandValueResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "handValue"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "handValue": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Derived from the ranks of the cards currently held in the player's hand."
          }
        }
      },
      "GetPlayersHandValueResponse": {
        "type": "array",
        "additionalProperties": false,
        "items": {
          "$ref": "#/components/schemas/GetPlayerHandValueResponse"
        }
      },
      "GetUndealtCardsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hearts",
          "spades",
          "clubs",
          "diamonds"
        ],
        "properties": {
          "hearts": {
            "type": "object",
            "$ref": "#/components/schemas/GetUndealtSuitCardsResponse"
          },
          "spades": {
            "type": "object",
            "$ref": "#/components/schemas/GetUndealtSuitCardsResponse"
          },
          "clubs": {
            "type": "object",
            "$ref": "#/components/schemas/GetUndealtSuitCardsResponse"
          },
          "diamonds": {
            "type": "object",
            "$ref": "#/components/schemas/GetUndealtSuitCardsResponse"
          }
        }
      },
      "GetUndealtSuitCardsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "king",
          "queen",
          "jack",
          "10",
          "9",
          "8",
          "7",
          "6",
          "5",
          "4",
          "3",
          "2",
          "ace"
        ],
        "properties": {
          "king": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "queen": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "jack": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "10": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "9": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "8": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "7": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "6": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "5": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "4": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "3": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "2": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "ace": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "GetUndealtSuitCardsCountResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hearts",
          "spades",
          "clubs",
          "diamonds"
        ],
        "properties": {
          "hearts": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
